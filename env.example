# Copy to backend/.env and adjust. Postgres from: docker compose up -d
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/jobtracker

JWT_SECRET=change-me-in-dev-use-long-random-string
JWT_EXPIRE_HOURS=24
CORS_ORIGINS=http://localhost:5173

AUTH_MODE=local
STORAGE_BACKEND=none

# LLM: mock (no network) | chat (OpenAI-compatible HTTP: Ollama, OpenAI, Gemini, etc.)
LLM_PROVIDER=chat
LLM_MODEL=gemma4:e4b
# Optional; defaults to http://127.0.0.1:11434/v1 when unset (Ollama)
# LLM_BASE_URL=http://127.0.0.1:11434/v1 cloud OpenAI-compatible base, trailing /v1
# LLM_API_KEY=  # omit for local Ollama; set for OpenAI / Gemini / other hosted APIs
# Remote Ollama (non-localhost): set true to use /api/chat + JSON schema enforcement
# LLM_OLLAMA_FORCE_NATIVE_SCHEMA=false
